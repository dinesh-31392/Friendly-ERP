# ─── Friendly CRM production secrets ─────────────────────────────────────────
# Copy to `.env` next to docker-compose.prod.yml and CHANGE EVERY VALUE.
# Generate strong values:  openssl rand -hex 24

POSTGRES_PASSWORD=CHANGE_ME_pg_superuser
APP_USER_PASSWORD=CHANGE_ME_rls_app_role
APP_PLATFORM_PASSWORD=CHANGE_ME_platform_role
JWT_SECRET=CHANGE_ME_min_32_chars_random_string!!

# Passphrase that encrypts the nightly database backups (AES-256). Store it
# somewhere OTHER than the server — a backup you can't decrypt is useless, and a
# passphrase sitting next to the backups defeats the encryption.
BACKUP_PASSPHRASE=CHANGE_ME_backup_encryption_passphrase

# Your public URL (used for CORS). With a domain + SSL:
#   PUBLIC_URL=https://crm.yourdomain.com
# Before DNS/SSL you can use the VPS IP:
#   PUBLIC_URL=http://YOUR_VPS_IP
PUBLIC_URL=http://YOUR_VPS_IP

# ─── WhatsApp gateway (optional) ─────────────────────────────────────────────
# Only needed if you run the Evolution overlay:
#   docker compose -f docker-compose.prod.yml -f evolution.prod.yml up -d
#
# Shared secret between the ERP API and the gateway. Generate your own:
#   openssl rand -hex 24
EVOLUTION_API_KEY=CHANGE_ME_evolution_gateway_key

# Default country code applied to leads stored as bare 10-digit numbers
# (e.g. 7559465215 → 917559465215). Set to your market.
WHATSAPP_DEFAULT_CC=91

# Background outbox worker: sends queued auto-replies without anyone opening
# the app. Leave unset for the 30s default; WHATSAPP_WORKER=off disables it.
# WHATSAPP_WORKER_INTERVAL_MS=30000

# ── Email (sign-in codes) ───────────────────────────────────────────────────
# Platform admins sign in with a password AND a 6-digit code emailed to them.
# With no mail configured they CANNOT sign in at all — so set this before you
# enable MFA on any account you rely on.
#
# Gmail:          smtp.gmail.com / 587. Needs an APP PASSWORD, not the Google
#   password — Google stopped accepting those for SMTP in 2022. Turn on 2-Step
#   Verification first (App Passwords do not exist without it), generate one at
#   myaccount.google.com/apppasswords, and paste it WITHOUT the spaces Google
#   shows it with. Fine for a few admins; the free limit is ~500/day.
# Microsoft 365:  smtp.office365.com / 587   (the mailbox must have SMTP AUTH
#   enabled — Microsoft disables it by default on many tenants, and the failure
#   is an authentication error at send time, not at boot)
# Resend:         smtp.resend.com / 465, user "resend", pass = the API key
# Brevo:          smtp-relay.brevo.com / 587
#
# Test it before trusting it:  npm run mail:test -- you@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraccount@gmail.com
SMTP_PASS=
# Must be an address the SMTP account is allowed to send as, or the provider
# rejects the message.
# Must be an address the account may send as — for Gmail, the account itself.
SMTP_FROM=Friendly ERP <youraccount@gmail.com>

# Minutes a sign-in code stays valid.
MFA_CODE_TTL_MINUTES=10

# MAIL_TRANSPORT=console PRINTS sign-in codes to the server log instead of
# emailing them. For bringing a box up before SMTP works. It logs a warning on
# every send because a live deployment running this way is publishing working
# credentials into its logs.
# MAIL_TRANSPORT=console

# ─── Online payments — Razorpay (optional) ───────────────────────────────────
# Until these are set, the payment routes refuse cleanly and the rest of the
# product is unaffected: demands are still raised and receipts still recorded,
# they are just marked paid by hand instead of collected online.
#
# The webhook secret is NOT the API secret. It is set separately in the
# Razorpay dashboard under Settings → Webhooks, and the endpoint to register is
#   <PUBLIC_URL>/api/webhooks/razorpay
# Signature verification uses the RAW request body, so a proxy that rewrites
# the body will break it — nginx as configured here does not.
#
# One more step outside this file: "Pay online" loads Razorpay's checkout
# script, which the Content-Security-Policy blocks by default. Regenerate it
# with the gateway allowed:  node deploy/gen-csp.mjs --razorpay
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# ─── Click-to-call — Exotel (optional) ───────────────────────────────────────
# The rep's number never reaches the customer: the provider dials the agent
# first, then bridges. Without these the call button reports that telephony is
# not configured rather than half-working.
#
# The account and caller id are ALSO set per workspace in Settings → the
# credentials here are deployment-level, the ExoPhone is per builder.
#
# Call status, duration and recording come back on a callback to
#   <PUBLIC_URL>/api/webhooks/telephony
# which is derived from PUBLIC_URL above. If PUBLIC_URL is wrong or unset the
# call still connects and the outcome never returns.
# EXOTEL_ACCOUNT_SID=
# EXOTEL_API_KEY=
# EXOTEL_API_TOKEN=
# EXOTEL_CALLER_ID=

# ─── Uploaded documents ──────────────────────────────────────────────────────
# Agreements, KYC scans and generated PDFs are written to a named Docker volume
# (`uploads`), NOT into the image — the compose file mounts it and the
# Dockerfile pre-creates it owned by the non-root user. Nothing to set here
# unless you want a different per-file ceiling.
#
# Both the volume AND the database must be restored together: the database
# stores a storage key, never the bytes. backup.sh archives both.
# MAX_UPLOAD_MB=25

# ─── Metrics (optional) ──────────────────────────────────────────────────────
# /metrics is not proxied by nginx, so it is reachable only from inside the
# compose network. Set a token only if you scrape it from another host.
# METRICS_TOKEN=
