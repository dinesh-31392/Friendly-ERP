# ─── Host nginx vhost: erp.example.com → the ERP stack on 127.0.0.1:8080 ────
#
# For a VPS whose port 80/443 already belong to WordPress. Copy to
# /etc/nginx/sites-available/erp.example.com, replace ERP_DOMAIN, symlink into
# sites-enabled, then `nginx -t && systemctl reload nginx`.
#
# Issue the certificate FIRST (this file references it):
#   certbot certonly --webroot -w /var/www/html -d ERP_DOMAIN
# `--webroot`, not `--standalone`: standalone needs port 80, which nginx is
# holding, so it would fail — or worse, you would stop nginx to free the port
# and take WordPress down to issue a certificate.

server {
    listen 80;
    listen [::]:80;
    server_name ERP_DOMAIN;

    # Leave this reachable over plain HTTP so renewals keep working.
    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ERP_DOMAIN;

    ssl_certificate     /etc/letsencrypt/live/ERP_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ERP_DOMAIN/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    # HSTS is per-hostname, so this does not touch WordPress. Do not add
    # includeSubDomains here unless every subdomain is already HTTPS-only.
    add_header Strict-Transport-Security "max-age=31536000" always;

    # A booking's cost sheet or a document upload is bigger than the 1 MB default.
    client_max_body_size 25m;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        # APPENDS the real peer. The API runs trustProxy=1 and reads exactly one
        # hop, so req.ip is this value — which is what the login rate limit and
        # the audit trail's ip_address depend on. Setting this to $remote_addr
        # alone, or omitting it, breaks both quietly.
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # The WhatsApp inbox polls; a short read timeout shows it as broken.
        proxy_read_timeout 120s;
    }
}
