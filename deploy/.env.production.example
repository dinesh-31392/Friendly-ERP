# ─── Friendly CRM production secrets ─────────────────────────────────────────
# Copy to `.env` next to docker-compose.prod.yml and CHANGE EVERY VALUE.
# Generate strong values:  openssl rand -hex 24

POSTGRES_PASSWORD=CHANGE_ME_pg_superuser
APP_USER_PASSWORD=CHANGE_ME_rls_app_role
APP_PLATFORM_PASSWORD=CHANGE_ME_platform_role
JWT_SECRET=CHANGE_ME_min_32_chars_random_string!!

# Passphrase that encrypts the nightly database backups (AES-256). Store it
# somewhere OTHER than the server — a backup you can't decrypt is useless, and a
# passphrase sitting next to the backups defeats the encryption.
BACKUP_PASSPHRASE=CHANGE_ME_backup_encryption_passphrase

# Your public URL (used for CORS). With a domain + SSL:
#   PUBLIC_URL=https://crm.yourdomain.com
# Before DNS/SSL you can use the VPS IP:
#   PUBLIC_URL=http://YOUR_VPS_IP
PUBLIC_URL=http://YOUR_VPS_IP

# ─── WhatsApp gateway (optional) ─────────────────────────────────────────────
# Only needed if you run the Evolution overlay:
#   docker compose -f docker-compose.prod.yml -f evolution.prod.yml up -d
#
# Shared secret between the ERP API and the gateway. Generate your own:
#   openssl rand -hex 24
EVOLUTION_API_KEY=CHANGE_ME_evolution_gateway_key

# Default country code applied to leads stored as bare 10-digit numbers
# (e.g. 7559465215 → 917559465215). Set to your market.
WHATSAPP_DEFAULT_CC=91

# Background outbox worker: sends queued auto-replies without anyone opening
# the app. Leave unset for the 30s default; WHATSAPP_WORKER=off disables it.
# WHATSAPP_WORKER_INTERVAL_MS=30000
