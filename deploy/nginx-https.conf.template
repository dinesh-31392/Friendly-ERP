# Friendly CRM — nginx with HTTPS. Rendered from this template by
# enable-https.sh (which substitutes __DOMAIN__ and validates with `nginx -t`
# before reloading). Do not edit the deployed copy by hand — re-run the script.

# ── HTTP: ACME challenge + redirect everything else to HTTPS ─────────────────
server {
    listen 80;
    server_name __DOMAIN__;
    server_tokens off;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

# ── HTTPS: the app ───────────────────────────────────────────────────────────
server {
    listen 443 ssl;
    http2 on;
    server_name __DOMAIN__;
    server_tokens off;

    ssl_certificate     /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    # ── Security headers ──
    #
    # Repeated in every location below, deliberately: nginx drops ALL inherited
    # add_header directives in any block that declares one of its own, and
    # `try_files … /index.html` redirects into exactly such a block. See
    # deploy/nginx.conf for the full explanation.
    #
    # HSTS lives here rather than in the generated file because it belongs to
    # the TLS terminator, not to the bundle.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    include /etc/nginx/security-headers.conf;

    location /api/ {
        proxy_pass http://api:4000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    types { application/manifest+json webmanifest; }

    location = /sw.js {
        root /usr/share/nginx/html;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Service-Worker-Allowed "/" always;
        types { application/javascript js; }
    }
    location = /index.html {
        root /usr/share/nginx/html;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache" always;
    }
    location /icons/ {
        root /usr/share/nginx/html;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    # The chatbot widget, framable by the builder sites that embed it. See the
    # matching block in deploy/nginx.conf for why it names index.html directly
    # instead of falling through to the SPA fallback.
    location ^~ /chat/ {
        root /usr/share/nginx/html;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        include /etc/nginx/security-headers-embed.conf;
        add_header Cache-Control "no-cache" always;
        try_files /index.html =404;
    }
    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    gzip on;
    gzip_types text/plain text/css text/html application/json application/javascript application/manifest+json image/svg+xml;
    client_max_body_size 10m;
}
