# Superuser URL — used ONLY by migrations/seed (scripts/*)
DATABASE_ADMIN_URL=postgres://postgres:postgres_dev_only@localhost:5433/friendly_crm

# The API's runtime role — RLS-enforced, NOBYPASSRLS
DATABASE_URL=postgres://app_user:app_user_dev_only@localhost:5433/friendly_crm

# Platform role — BYPASSRLS. Used ONLY for the login credential lookup and
# platform jobs (backups, super admin). Keep these credentials separate.
DATABASE_PLATFORM_URL=postgres://app_platform:app_platform_dev_only@localhost:5433/friendly_crm

APP_USER_PASSWORD=app_user_dev_only
APP_PLATFORM_PASSWORD=app_platform_dev_only

JWT_SECRET=change-me-in-production-min-32-chars!!
PORT=4000
CORS_ORIGIN=http://localhost:5173
