# Dependencies
node_modules/
server/node_modules/

# Build output
dist/
server/dist/

# Secrets — NEVER commit real values (use .env.example as the template)
.env
.env.*
!.env.example
!.env.production.example
server/.env
deploy/.env

# Local database (embedded Postgres data — regenerated by localdb/start-db.mjs)
localdb/pgdata/
localdb/*.log

# Local / editor / tooling
*.log
.DS_Store
.vscode/
.idea/
Thumbs.db
**/.claude/settings.local.json
.claude/

# A separate product that happens to share this parent folder — the Origin Corp
# marketing site. It is not part of the ERP and does not belong in this repo.
origincorp-revamp/

# Generated by deploy/gen-csp.mjs from the built bundle, and deliberately NOT
# committed. The CSP pins the inline script by hash, so a stale copy in the repo
# would serve users a blank page. Absent, the nginx mount fails and the
# container refuses to start — a loud failure instead of a silent one.
deploy/security-headers.conf
deploy/security-headers-embed.conf

# Uploaded files. The bytes belong on a mounted volume (FILE_STORAGE_DIR), never
# in the repository — a customer's KYC scans committed by accident cannot be
# un-published, and the default path sits inside the working tree.
server/var/
