# Superuser URL — used ONLY by migrations/seed (scripts/*)
DATABASE_ADMIN_URL=postgres://postgres:postgres_dev_only@localhost:5433/friendly_crm

# The API's runtime role — RLS-enforced, NOBYPASSRLS
DATABASE_URL=postgres://app_user:app_user_dev_only@localhost:5433/friendly_crm

# Platform role — BYPASSRLS. Used ONLY for the login credential lookup and
# platform jobs (backups, super admin). Keep these credentials separate.
DATABASE_PLATFORM_URL=postgres://app_platform:app_platform_dev_only@localhost:5433/friendly_crm

APP_USER_PASSWORD=app_user_dev_only
APP_PLATFORM_PASSWORD=app_platform_dev_only

JWT_SECRET=change-me-in-production-min-32-chars!!
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Login attempts allowed per address per minute. Leave this alone in production:
# five is what makes password guessing expensive, and the login route is the one
# place an attacker gets to guess. It exists as a setting only so the
# verification suites can sign in one after another without throttling
# themselves. CI sets it to 200; a real deployment should not set it at all.
AUTH_RATE_LIMIT_MAX=5

# ── File storage ─────────────────────────────────────────────────────────────
# Where uploaded documents are written. Point this at a MOUNTED VOLUME in
# production: the default sits inside the working tree, so a redeploy that
# replaces the directory takes every customer's agreements with it. The
# database keeps the metadata and the path; the bytes are only here.
FILE_STORAGE_DIR=./var/uploads

# Per-file ceiling in megabytes. Enforced while the upload streams, so an
# oversized file is cut off rather than buffered and then rejected.
MAX_UPLOAD_MB=25

# ── Observability ────────────────────────────────────────────────────────────
# /metrics serves Prometheus text format and carries NO tenant labels — by
# design, because per-tenant series both explode cardinality and publish the
# customer list to anyone who can scrape.
#
# Unauthenticated, and restricted to loopback and private ranges. Set a token
# ONLY if the scraper lives outside those ranges; it then becomes the sole
# check, so treat it as a credential.
# METRICS_TOKEN=

# /api/health      — SELECT 1. Enough to restart a dead container.
# /api/health/deep — both pools AND the connection queue, returning 503 when
#                    unusable so a load balancer takes the instance out. Point
#                    the readiness probe at this one; SELECT 1 stays green
#                    while every request is queueing for a connection.

# ── Payment gateway (Razorpay) ───────────────────────────────────────────────
# Absent, online payment routes answer 503 rather than half-working.
#
# The KEY ID is public by design — Razorpay's checkout script needs it in the
# browser. The KEY SECRET signs money movement: it never leaves the server, is
# never stored in the database, and is not readable from any settings page.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Set this separately in the Razorpay dashboard. It signs the WEBHOOK, which is
# the only thing that records a payment — the browser is never believed. Falls
# back to the key secret if unset, which works but means one leaked value
# compromises both.
RAZORPAY_WEBHOOK_SECRET=

# Point Razorpay's webhook at:  POST https://<your-host>/api/webhooks/razorpay
# subscribing to payment.captured and payment.failed.

# ── Portal lead ingest ───────────────────────────────────────────────────────
# No environment variables. Each portal's credential is minted per workspace in
# the app (Leads → sources) and stored only as a digest, so a leaked key is
# revoked for one portal without taking the others down. Give the portal:
#
#   POST https://<your-host>/api/public/leads/ingest/<99acres|magicbricks|housing|website|landing_page>
#   header  x-lead-source-secret: <the token shown once at creation>

# ── Telephony (Exotel) ───────────────────────────────────────────────────────
# Absent, click-to-call answers 503 rather than half-working.
#
# These place calls the builder is BILLED for, so they live here and never in
# the database — a workspace admin must not be able to read them out of a
# settings page. The account sid and the ExoPhone are per workspace and are set
# in the app (Settings → Telephony), because each builder has their own.
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=

# Optional deployment-wide fallbacks, used when a workspace has not set its own.
EXOTEL_ACCOUNT_SID=
EXOTEL_CALLER_ID=

# Where the provider should send status callbacks. Without it no callback URL is
# sent at all — better than one pointing at localhost, which Exotel retries for
# hours. The callback secret is minted per workspace in the app.
PUBLIC_BASE_URL=
